{{{
  exports({ to: app.configPath('function_points.ts') })
}}}
import { defineConfig } from '@filipebraida/adonis-function-points'

export default defineConfig({
  /**
   * The application boundary is a business decision, not a technical one.
   * Review it with whoever signs the contract, not only with the team.
   */
  boundary: {
    infrastructure: ['access_tokens', 'reset_password_tokens', 'audits'],
    ignoreEntryPoints: ['drive.fs.serve', 'prometheus.metrics'],
    externallyMaintained: [],

    /**
     * Business data the AFP naming filter excluded by accident.
     *
     * It drops anything containing `session`, `template`, `error` or `types`,
     * which is right for infrastructure and wrong for, say, a chat session the
     * user manages. Check the confidence block of `fp:count` for what it
     * excluded, and list here what is really business.
     */
    business: [],
  },

  /** Logical subgroups (RET). `constant` pins it at 1, which is honest. */
  retStrategy: 'constant',

  /** How far to follow the call graph from the handler. */
  maxDepth: 3,

  /** Refuses to emit a count if tracing covers less than this. */
  minCoverage: 0.85,

  /**
   * Facts static analysis cannot read, declared with a required justification.
   *
   * The case this exists for: fields the user fills that live in a JSON column
   * whose schema is stored in the database. See counting-decisions §8 — and use
   * it sparingly, because `fp:count` reports what share of the total came from
   * here.
   */
  // overrides: {
  //   // one schema, or several whose fields are unioned by leaf path
  //   Form: { detFromSchema: ['intakeSchema', 'reviewSchema'], reason: 'one per template' },
  //
  //   // 1 DET is a floor, and `fp:count` says so on every run. When 1 IS the right
  //   // answer, record that someone checked — otherwise the warning becomes noise
  //   // the team learns to scroll past. It moves no number.
  //   Petition: { opaqueReviewed: ['schema', 'uiSchema'], reason: 'metadata; one field each' },
  // },

  /**
   * How change is priced. A clause of the contract, not a flag.
   *
   * AEP anchors added at 1 and deleted at 0.4. For a MODIFIED function it grades
   * the factor from 0.25 to 1.75 through Effort Complexity variation, which needs
   * cyclomatic complexity this package does not measure — so it defaults to 1,
   * which overestimates, and every `fp:diff` says so.
   *
   * `implementation` means same type, same DET, same FTR, different body: a
   * refactor. Whether that is billable, and at what, is a decision for whoever
   * signs the contract — not one this package should invent.
   */
  // diff: {
  //   reasonFactors: { implementation: 0.25 },
  // },
})
