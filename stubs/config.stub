{{{
  exports({ to: app.configPath('function_points.ts') })
}}}
import { defineConfig } from '@filipebraida/adonis-function-points'

export default defineConfig({
  /**
   * The application boundary is a business decision, not a technical one.
   * Review it with whoever signs the contract, not only with the team.
   */
  boundary: {
    infrastructure: ['access_tokens', 'reset_password_tokens', 'audits'],
    ignoreEntryPoints: ['drive.fs.serve', 'prometheus.metrics'],
    externallyMaintained: [],
  },

  /** Logical subgroups (RET). `constant` pins it at 1, which is honest. */
  retStrategy: 'constant',

  /** How far to follow the call graph from the handler. */
  maxDepth: 3,

  /** Refuses to emit a count if tracing covers less than this. */
  minCoverage: 0.85,
})
